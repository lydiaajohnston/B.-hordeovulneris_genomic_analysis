#!/bin/bash

# Define project paths
PROJECT="/mnt/c/Users/Lydia/Documents/bh_project/A.hordeovulneris"

# Bakta database directory
DB="$HOME/databases/bakta/db"

# Genome assemblies
CAT_ASSEMBLY="$PROJECT/spades_cat/contigs.fasta"
DOG_ASSEMBLY="$PROJECT/spades_dog/contigs.fasta"

# Output directory
OUTPUT="$PROJECT/bakta_results"

mkdir -p "$OUTPUT/cat" "$OUTPUT/dog"

# Run bakta on cat isolate 
bakta \
    --db "$DB" \
    --output "$OUTPUT/cat" \
    --prefix cat_isolate \
    --threads 6 \
    "$CAT_ASSEMBLY"

# Run bakta on dog isolate 
bakta \
    --db "$DB" \
    --output "$OUTPUT/dog" \
    --prefix dog_isolate \
    --threads 4\
    "$DOG_ASSEMBLY"

# Run bakta on a group of reference genomes 
REF_DIR="$PROJECT/ncbi_buchananella_wholegenome_ref/ncbi_dataset/data"
OUT_DIR="$PROJECT/bakta_references"


for genome in "$REF_DIR"/GCF_*/*.fna
do
    accession=$(basename "$(dirname "$genome")")

    echo "=================================="
    echo "Annotating $accession"
    echo "Input: $genome"
    echo "=================================="

    bakta \
        --db "$DB" \
        --output "$OUT_DIR/$accession" \
        --prefix "$accession" \
        --threads 6 \
        "$genome"

    if [ $? -ne 0 ]; then
        echo "ERROR: Bakta failed on $accession"
        break
    fi

done

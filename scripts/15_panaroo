#!/bin/bash
# Define Variables 
PROJECT="/mnt/c/Users/Lydia/Documents/bh_project/A.hordeovulneris"

# Run panaroo with 
panaroo -i "$PROJECT/panaroo/gff3/*.gff3 -o "$PROJECT/panaroo_results/cat" --clean-mode sensitive --threshold 0.7 --family_threshold 0.5 -t 8
panaroo \
    -i "$PROJECT/panaroo/gff3/"*.gff3 \
    -o "$PROJECT/panaroo_results" \
    --clean-mode sensitive \
    --threshold 0.7 \
    --family_threshold 0.5 \
    -t 8
